# Нормализация переводов строк: в репозитории храним LF, чтобы синхронизация
# с Windows не превращала каждый файл в сплошной diff (CRLF↔LF).
* text=auto eol=lf

# Windows-скрипты должны оставаться CRLF в рабочем дереве
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Бинарные файлы — без нормализации и diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
