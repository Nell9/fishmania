# КлёвГид backend — окружение. Скопируйте в .env (не коммитится).

# === Транспорт к Claude ===
# auto — CLI при наличии бинаря `claude`, иначе SDK при ANTHROPIC_API_KEY, иначе local (по умолчанию)
# cli  — Claude Code CLI (без API-ключа, авторизация по подписке). Выбирай это, если ключа нет.
# sdk  — официальный Anthropic SDK (нужен ANTHROPIC_API_KEY)
# off  — только локальный детерминированный движок
KLEVGID_AI_TRANSPORT=auto

# --- CLI-транспорт (без API-ключа) ---
# Авторизация по подписке Claude (Pro/Max):
#   разово на машине:  claude        затем  /login   (вход в браузере)
#   на сервере/headless:  claude setup-token  →  положить токен сюда:
# CLAUDE_CODE_OAUTH_TOKEN=
# Путь к бинарю, если claude не в PATH; таймаут одного вызова CLI, сек:
# KLEVGID_CLAUDE_BIN=claude
KLEVGID_CLI_TIMEOUT=60

# --- SDK-транспорт (если есть ключ) ---
# ANTHROPIC_API_KEY=

# Модель по умолчанию — Haiku (быстро/дёшево). Допустимы и алиасы: haiku | sonnet | opus.
KLEVGID_MODEL_ANALYZE=claude-haiku-4-5-20251001
KLEVGID_MODEL_TACTICS=claude-haiku-4-5-20251001

KLEVGID_CORS=*
KLEVGID_DB=./klevgid.db
