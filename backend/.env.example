# КлёвГид backend — пример окружения. Скопируйте в .env (не коммитится).

# Ключ Anthropic. Задаётся на сервере; в код и git не попадает.
# Без ключа бэкенд полностью работает в детерминированном local-режиме.
ANTHROPIC_API_KEY=

# Модели: разбор видов — Haiku (быстро/дёшево), тактика — Sonnet (качественнее).
KLEVGID_MODEL_ANALYZE=claude-haiku-4-5-20251001
KLEVGID_MODEL_TACTICS=claude-sonnet-4-6

# CORS: домены фронтенда через запятую, или * для всех.
KLEVGID_CORS=*

# Путь к базе знаний SQLite (по умолчанию backend/klevgid.db).
KLEVGID_DB=./klevgid.db
